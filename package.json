{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "PORT=3000 npx tsx server.ts",
    "server": "node server/index.js",
    "owner:dev": "npm run dev --prefix lunaoownerpwa",
    "owner:build": "npm run build --prefix lunaoownerpwa",
    "owner:start": "node server/index.js",
    "pipeline": "node scripts/run-pipeline.mjs",
    "build": "npm run owner:build && vite build",
    "preview": "vite preview",
    "start": "tsx server.ts",
    "clean": "rm -rf dist server/.sites",
    "lint": "tsc --noEmit",
    "test": "node scripts/test-email-automations-readiness.mjs && node scripts/test-booking-beta-contract.mjs",
    "test:contract": "node scripts/test-booking-beta-contract.mjs",
    "test:auth": "node scripts/test-authentication-security.mjs",
    "db:migrate": "node scripts/db-migrate.mjs",
    "db:backup": "node scripts/db-backup.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.104.1",
    "@google/genai": "^2.8.0",
    "@react-oauth/google": "^0.13.5",
    "@supabase/supabase-js": "^2.118.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "jose": "^6.2.3",
    "js-cookie": "^3.0.8",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pg": "^8.21.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "resend": "^6.34.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^4.17.21",
    "@types/js-cookie": "^3.0.6",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "wrangler": "^4.42.0"
  }
