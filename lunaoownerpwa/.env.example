# GEMINI_API_KEY: Required for Gemini AI API calls (chatbot).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted (used for self-referential links).
APP_URL="MY_APP_URL"

# LUNAO_API_BASE_URL: Backend API origin. Defaults to http://localhost:8787
# in dev. In production this is owner.lunao.com (same origin), so the var
# is not needed — /api/* calls resolve to the current domain.
LUNAO_API_BASE_URL="http://localhost:8787"

# VITE_OWNER_PWA_URL: Absolute URL of the deployed Owner PWA. Surfaced in the
# agency's "Generate Owner PWA" drawer so the operator can deep-link owners
# straight into the login modal pre-filled with their invite code.
VITE_OWNER_PWA_URL="http://localhost:3001"

# Optional dev port override.
# PWA_DEV_PORT=3001
