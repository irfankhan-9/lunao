###############################################################################
# LUNAO SaaS — PRODUCTION .env
# Copy this to /var/www/lunao/.env and fill in ALL values.
#
# ⚠️  DO NOT use development mock fallbacks in production!
# ⚠️  Every key below marked [REQUIRED] must have a real value.
###############################################################################

# ─── NODE ────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=8787

# ─── SUPABASE (Database) [REQUIRED] ─────────────────────────────────────────
SUPABASE_URL=https://wqlbuadknltsjfzrltpe.supabase.co
SUPABASE_SECRET_KEY=YOUR_REAL_SUPABASE_SERVICE_ROLE_KEY
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.wqlbuadknltsjfzrltpe.supabase.co:5432/postgres

# ─── AUTHENTICATION [REQUIRED] ──────────────────────────────────────────────
JWT_SECRET=GENERATE_A_STRONG_64_CHAR_SECRET_HERE
SESSION_SECRET=GENERATE_ANOTHER_STRONG_SECRET_HERE
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
VITE_GOOGLE_CLIENT_ID=

# ─── CLOUDFLARE (Site Deployment) [REQUIRED for site deploy] ────────────────
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_PAGES_PROJECT=lunao-web-designn
CLOUDFLARE_PAGES_BRANCH=main

# ─── TELNYX (SMS) [REQUIRED for SMS campaigns] ──────────────────────────────
TELNYX_API_KEY=
TELNYX_PHONE_NUMBER=
TELNYX_MESSAGING_PROFILE_ID=
SMS_ENABLED=true

# ─── RESEND (Email) [REQUIRED for email campaigns] ──────────────────────────
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_TEST_RECIPIENT=

# ─── AI SERVICES ─────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# ─── GOOGLE MAPS [REQUIRED for Places API lead generation] ──────────────────
GOOGLE_MAPS_API_KEY=

# ─── EMAIL ENCRYPTION ────────────────────────────────────────────────────────
EMAIL_TOKEN_ENCRYPTION_KEY=GENERATE_A_32_BYTE_HEX_KEY

# ─── SITE GATE ───────────────────────────────────────────────────────────────
SITE_GATE_JWT_SECRET=
SITE_GATE_PASSWORD_HASH=

# ─── PUBLIC URLs [REQUIRED] ─────────────────────────────────────────────────
PUBLIC_API_BASE_URL=https://api.lunao.app
LUNAO_API_BASE_URL=https://api.lunao.app
SITE_BASE_URL=https://lunao-web-designn.pages.dev
OAUTH_REDIRECT_BASE=https://api.lunao.app

# ─── SERPAPI ──────────────────────────────────────────────────────────────────
SERPAPI_API_KEY=

# ─── OWNER PWA ───────────────────────────────────────────────────────────────
VITE_OWNER_PWA_URL=https://api.lunao.app/owner
